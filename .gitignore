node_modules/
dist/
*.log
.DS_Store
.env

# Generated artifact — derived from the OpenAPI spec, served live at
# api.getxapi.com/mcp/manifest. Not committed to the repo. Still bundled into
# the npm tarball (via package.json "files") as an offline fallback — npm's
# "files" allowlist ships it regardless of this gitignore (same as dist/).
manifest.json

# Monorepo-coupled build script — needs ../../docs/openapi.json and exposes the
# openapi→manifest internals. Deliberately excluded from the public repo.
scripts/

# Lock file is not tracked in the public repo.
package-lock.json
